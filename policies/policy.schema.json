{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Kanban signed policy",
  "type": "object",
  "required": [
    "schema_version", "policy_id", "scope", "issued_at", "expires_at",
    "trust_epoch", "compatibility", "authority", "rules"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "trust_epoch": {"type": "integer", "minimum": 1},
    "compatibility": {
      "type": "object",
      "required": ["host_version", "plugin_version", "executor_version", "policy_version"],
      "properties": {
        "host_version": {"type": "string", "minLength": 1},
        "plugin_version": {"type": "string", "minLength": 1},
        "executor_version": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["effect_classes"],
      "properties": {
        "effect_classes": {
          "type": "array",
          "items": {"enum": ["read_only", "idempotent", "reversible", "irreversible"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "rules": {"type": "object"}
  },
  "additionalProperties": false
}
